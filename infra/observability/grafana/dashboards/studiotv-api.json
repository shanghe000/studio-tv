{
  "uid": "studiotv-api-overview",
  "title": "Studio TV · 服务监控",
  "description": "API、IPAC/Models Router 首响应、数据库连接池与 Go 运行时；数据来自私有 api:9090，不含用户内容或凭据。",
  "tags": [
    "studiotv",
    "api",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API 指标可达",
      "description": "1 表示 api:9090 /metrics 抓取成功；0 表示抓取失败。无数据不能视为健康。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "studiotv-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"studiotv-api\"}",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "无数据"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "不可达",
                  "color": "red"
                },
                "1": {
                  "text": "可达",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
