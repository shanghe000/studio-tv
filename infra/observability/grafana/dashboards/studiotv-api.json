          "expr": "(sum(rate(studiotv_http_requests_total{job=\"studiotv-api\",status_class=\"5xx\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(studiotv_http_requests_total{job=\"studiotv-api\"}[$__rate_interval])), 0.000001)",
