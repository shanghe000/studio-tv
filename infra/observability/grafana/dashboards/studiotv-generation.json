{
  "uid": "studiotv-generation-overview",
  "title": "Studio TV · 生成队列与服务心跳",
  "description": "真实 STUDIO 持久化队列、H3/ComfyUI下游队列和服务心跳。分层观察，不能相加；离线或过期显示未知，不伪造空队列。",
  "tags": [
    "studiotv",
    "generation",
    "h3",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "STUDIO API 就绪",
      "description": "每 15 秒主动只读探测；1 为当前检查通过，0 为检查失败。H3 就绪检查服务进程、worker配置、Comfy接口和必需节点，不提交GPU生成任务。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "studiotv-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "studiotv_generation_service_ready{job=\"generation-exporter\",service=\"studiotv_api\"} and on(job,instance) (up{job=\"generation-exporter\"} == 1) and on(job,instance) (time() - studiotv_generation_collector_last_poll_timestamp_seconds{job=\"generation-exporter\"} < 40)",
          "legendFormat": "STUDIO API 就绪",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "未知／采集不可用"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "不可达",
                  "color": "red"
                },
                "1": {
                  "text": "可达",
                  "color": "green"
                }
              }
            }
