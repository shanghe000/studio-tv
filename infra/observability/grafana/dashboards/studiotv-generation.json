    {
      "id": 9,
      "type": "stat",
      "title": "画布 H3 等待",
      "description": "STUDIO 队列含尚未转发 Router 的任务；STUDIO 执行中还包含传输与资产回收。H3、ComfyUI是同一任务的下游观察，不要将这些层相加。",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "studiotv-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(studiotv_generation_tasks{job=\"studiotv-api\",capability_family=\"h3\",state=\"queued\"} and on(job,instance) (studiotv_generation_queue_sampler_up{job=\"studiotv-api\"} == 1) and on(job,instance) (time() - studiotv_generation_queue_last_success_timestamp_seconds{job=\"studiotv-api\"} < 30) and on(job,instance) (up{job=\"studiotv-api\"} == 1))",
          "legendFormat": "画布 H3 等待",
          "instant": true,
          "range": false
