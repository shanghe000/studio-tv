  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ConversationId": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      },
      "RunId": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      },
      "ProjectId": {
        "in": "path",
        "name": "projectId",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      },
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IfMatch": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        }
      },
      "After": {
        "in": "query",
        "name": "after",
        "schema": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "default": "0"
        }
      },
      "LastEventId": {
        "in": "header",
        "name": "Last-Event-ID",
        "schema": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "Limit": {
        "in": "query",
        "name": "limit",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        }
      }
    },
    "schemas": {
      "AgentParameters": {
        "type": "object",
        "properties": {
          "reasoningEffort": {
            "type": "string",
            "enum": [
              "low",
              "high"
            ],
            "default": "low"
          }
        },
        "additionalProperties": false
      },
      "AgentRun": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "conversationId",
          "projectId",
          "messageId",
          "capabilityRef",
          "capabilityVersion",
          "parameters",
          "expectedRevision",
          "state",
          "assistantMessageId",
          "credentialEpoch",
          "errorCode",
          "toolCount",
          "usage",
          "createdAt",
          "updatedAt",
          "deadline",
          "authExpiresAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^agr_[0-9a-f]{32}$"
          },
          "kind": {
