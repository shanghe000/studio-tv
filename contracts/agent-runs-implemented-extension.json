  "info": {
    "title": "Studio TV implemented direct canvas Agent run slice",
    "version": "0.1.0",
    "description": "IMPLEMENTED optional direct Agent service, enabled only with a configured independently isolated runtime and explicit validated fixed profile. New routes preserve legacy assistant/conversations/.../runs and frozen v1. No live paid model acceptance or deployment is implied by unit/protocol tests."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-implementation-stage": "IMPLEMENTED",
  "x-related-design": "../docs/agent-api-and-live-canvas-design.md",
  "x-profile-version": "studio-agent-tools-v1",
  "x-implemented-subset": {
    "capability": "codex-6-1-text-v1@2",
    "efforts": [
      "low",
      "high"
    ],
    "history": "Owned persisted TEXT USER/ASSISTANT, max100 messages/512KB; media and structured inputs unsupported.",
    "tools": [
      "studio_canvas_read",
      "studio_canvas_patch",
      "studio_model_list",
      "studio_node_run",
      "studio_task_read",
      "studio_task_cancel"
    ],
    "canvasRead": "Bounded explicit canvas.Context projection (100 nodes/200 edges, 1200 runes per selected text), no hidden native sidecars or signed links.",
    "taskRead": "Optional waitSeconds integer0..20, default10; normal user Bearer GET per poll, live reauthorization each time; generation worker is independent.",
    "durability": "Immutable owner/session/conversation/project binding and prompt/tool/profile/canonical request hashes; one active conversation; fenced leases; run+native call uniqueness; stable UUID downstream keys and terminal receipts.",
    "auth": "Bearer kept only in service memory, never model/prompt/log/workspace/database. On restart WAITING_FOR_AUTH; refresh cannot change local sid. Live expiry pauses same callback retaining lease.",
    "recovery": "Completed durable receipts may reconcile only exact actual native terminal snapshot; unknown submission never starts another model turn. Pending native turn after process crash may become UNKNOWN conservatively.",
    "budget": "Default10min deadline,32 calls,2 independent workers; bounded configurable deployment limits.",
    "notImplemented": [
      "Workflow/group execution tools",
      "undo",
      "generic HTTP/shell/files/browser tools",
      "media/STRUCTURED Agent history",
      "Ultra/sub-agent runtime profile",
      "cross-replica shared credential routing"
    ]
  },
