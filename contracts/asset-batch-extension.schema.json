{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studiotv.local/contracts/asset-batch-extension.schema.json",
  "title": "Asset metadata batch extension — IMPLEMENTED",
  "description": "POST /api/v2/assets/resolve-batch; 16 KiB request; one authenticated tv.access request; every asset rechecked with existing project/team read policy; no partial response or caching.",
  "x-implementation-status": "IMPLEMENTED",
  "x-method": "POST",
  "x-path": "/api/v2/assets/resolve-batch",
  "x-required-capability": "tv.access",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assetIds"
  ],
  "properties": {
    "assetIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetIds"
      ],
      "properties": {
        "assetIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "requestId",
        "data"
      ],
      "properties": {
        "code": {
          "const": 0
        },
        "message": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assets"
          ],
          "properties": {
            "assets": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "./openapi.json#/components/schemas/Asset"
              }
            }
          }
        }
      }
    }
  }
}
