{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Studio TV personal model provider credentials",
    "version": "1.0.0",
    "description": "IMPLEMENTED independent extension. User-scoped write-only API Keys are stored by the Router encrypted vault. No credential belongs in a canvas, model parameter, invocation JSON, project snapshot, or shared owner identity."
  },
  "servers": [
    {
      "url": "/api/v2"
    }
  ],
  "security": [
    {
      "SessionBearer": []
    }
  ],
  "paths": {
    "/me/model-provider-credentials": {
      "get": {
        "operationId": "listPersonalModelProviderCredentials",
        "x-implementation-status": "IMPLEMENTED",
        "x-required-capability": "tv.access",
        "summary": "Read only masked configuration status for the verified user",
        "description": "No query parameters. Returns both supported providers, including configurable=false when the encrypted vault is disabled. Never returns a Key.",
        "responses": {
          "200": {
            "description": "Masked personal provider configuration status",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialListResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/me/model-provider-credentials/{providerRef}": {
      "parameters": [
        {
          "name": "providerRef",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ProviderRef"
          }
        }
      ],
      "put": {
        "operationId": "savePersonalModelProviderCredential",
        "x-implementation-status": "IMPLEMENTED",
        "x-required-capability": "tv.access",
        "summary": "Save or replace the verified user's provider Key",
        "description": "Writes an encrypted personal vault version. Saving does not make a billable provider validation or generation request. The same provider Key automatically applies to that user's matching official model capabilities. MiniMax accepts region global or cn (omitted defaults to global); Seedance rejects region. No subjectRef, workspace, credentialRef, or user ID accepted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "apiKey"
                ],
                "properties": {
                  "apiKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "writeOnly": true,
                    "description": "Trimmed opaque Key, at most 4096 UTF-8 bytes and no internal whitespace or control characters. Never echoed."
                  },
                  "region": {
                    "type": "string",
                    "enum": [
                      "global",
                      "cn"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved metadata only",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      },
      "delete": {
        "operationId": "deletePersonalModelProviderCredential",
        "x-implementation-status": "IMPLEMENTED",
        "x-required-capability": "tv.access",
        "summary": "Remove the verified user's personal provider Key versions",
        "description": "No body or query parameters. Does not cancel already submitted provider tasks; removed versions cannot authorize new calls or recovery.",
        "responses": {
          "200": {
            "description": "Unconfigured metadata only",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "Failure": {
        "description": "400 unknown query/field or malformed JSON; 401 no verified identity; 403 tv.access denied; 413 body over 16 KiB; 415 non-JSON PUT; 422 unsupported provider, invalid Key or region; 501 adapter absent; 503 vault unavailable. Every response is no-store and carries a normalized safe error.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ProviderRef": {
        "type": "string",
        "enum": [
          "minimax-official",
          "volcengine-official"
        ]
      },
      "ProviderCredential": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerRef",
          "title",
          "configured",
          "maskedKey",
          "updatedAt",
          "configurable"
        ],
        "properties": {
          "providerRef": {
            "$ref": "#/components/schemas/ProviderRef"
          },
          "title": {
            "type": "string"
          },
          "configured": {
            "type": "boolean"
          },
          "maskedKey": {
            "type": "string",
            "description": "Empty when absent. Configured Keys show eight stars and at most four suffix characters; short Keys show only the stars."
          },
          "region": {
            "type": "string",
            "enum": [
              "global",
              "cn"
            ],
            "description": "MiniMax authentication domain; absent for Seedance."
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "configurable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "description": "Safe product explanation when configuration is unavailable."
          }
        }
      },
      "CredentialListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "requestId",
          "data"
        ],
        "properties": {
          "code": {
            "const": 0
          },
          "message": {
            "const": "OK"
          },
          "requestId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "items",
              "schemaVersion"
            ],
            "properties": {
              "schemaVersion": {
                "const": "1"
              },
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "#/components/schemas/ProviderCredential"
                }
              }
            }
          }
        }
      },
      "CredentialResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "requestId",
          "data"
        ],
        "properties": {
          "code": {
            "const": 0
          },
          "message": {
            "const": "OK"
          },
          "requestId": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ProviderCredential"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId",
          "retryable",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
