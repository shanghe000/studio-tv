# Copy to a private file outside this repository on deployment-host; generate real secrets.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
AUTH_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
# Preserve the legacy issuer/audience so existing login tokens survive renaming.
AUTH_ISSUER=rhtv-service
AUTH_AUDIENCE=rhtv-web
# Existing deployment-host installation only: pin both volumes and set reuse to true.
STUDIOTV_REUSE_EXISTING_DATA=false
# Existing deployments can retain their Compose ownership ID without restarting
# containers; their visible container names still use studio-tv-*.
STUDIOTV_COMPOSE_PROJECT=studio-tv
STUDIOTV_POSTGRES_VOLUME=studio-tv_postgres_data
STUDIOTV_ASSET_VOLUME=studio-tv_asset_data
PUBLIC_BASE_URL=http://localhost:18880
ALLOWED_ORIGINS=http://localhost:18880
ALLOW_LOCAL_HTTP=true
# Internal LAN HTTP only: set true with a literal RFC1918 IPv4 PUBLIC_BASE_URL.
# HTTPS and loopback development do not need this exception.
ALLOW_PRIVATE_HTTP=false
# deployment-host direct LAN access: WEB_BIND_IP=192.0.2.10, WEB_PORT=18880.
# Match PUBLIC_BASE_URL, ALLOWED_ORIGINS and registered IPAC_REDIRECT_URI.
WEB_BIND_IP=127.0.0.1
WEB_PORT=18880
RHTV_MODE=service
RHTV_EDITION=internal
# Empty overrides follow edition defaults. Internal billing is always disabled.
FEATURE_COMMUNITY=
FEATURE_BILLING=
FEATURE_PUBLIC_SHARING=
FEATURE_MARKETING=
FEATURE_EXTERNAL_LINKS=
# Optional internal observability. The Docker overlay supplies a private metrics
# bind; leave metrics disabled for the ordinary single-listener local setup.
LOG_LEVEL=info
STUDIOTV_ENV=internal
STUDIOTV_ALERT_WEBHOOK_URL=
# Prefer an absolute, read-only secret file. Never configure both sources.
STUDIOTV_ALERT_WEBHOOK_URL_FILE=
METRICS_ENABLED=false
METRICS_ADDR=127.0.0.1:9090
# Register the application and exact backend callback in IPAC first.
IPAC_ISSUER_URL=
# Runtime authorization and session-status base URL; empty uses the issuer.
IPAC_BASE_URL=
IPAC_APP_ID=
IPAC_APP_SECRET=
IPAC_REDIRECT_URI=http://localhost:18880/api/v1/auth/feishu/callback
IPAC_ALLOW_INSECURE_HTTP=false
# IPAC must provide its authenticated /oidc/session-status extension.
# Actual Feishu provenance is checked live; no subject allowlist bypass exists.

# Models Router catalog/session connection; all empty keeps it unconfigured.
# Use a private service token + distinct actor signing key, never browser tokens.
MODELS_ROUTER_BASE_URL=
# Empty uses studio-tv only when the connection is configured.
MODELS_ROUTER_CLIENT_APP=
MODELS_ROUTER_SERVICE_TOKEN=
MODELS_ROUTER_ACTOR_SIGNING_KEY_B64=
MODELS_ROUTER_TIMEOUT_SECONDS=
# Alternative *_FILE variables need external read-only secret mounts in Docker.
MODELS_ROUTER_SERVICE_TOKEN_FILE=
MODELS_ROUTER_ACTOR_SIGNING_KEY_B64_FILE=
