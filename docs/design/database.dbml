  // hf_revisions_manifest_sha256_check: CHECK (manifest_sha256 ~ '^[a-f0-9]{64}$'::text)
  // hf_revisions_revision_check: CHECK (revision > 0)
  // SQL trigger: CREATE TRIGGER hf_revisions_immutable BEFORE DELETE OR UPDATE ON studio.hf_revisions FOR EACH ROW EXECUTE FUNCTION platform.reject_version_update()
}

Table platform.inbox {
  source text [not null]
  event_id text [not null]
  payload_hash text [not null]
  state text [not null, default: `'RECEIVED'::text`]
  received_at "timestamp with time zone" [not null, default: `now()`]
  processed_at "timestamp with time zone" [null]
  result_code text [null]
  Note: '完整蓝图，建议后续；已认证提供方/内部回执去重：source/event_id、payload_hash、state/result。'
  indexes {
    (source, event_id) [name: 'inbox_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX inbox_pkey ON platform.inbox USING btree (source, event_id)']
  }
  // Conditional/expression index: CREATE INDEX inbox_pending_idx ON platform.inbox USING btree (received_at, source, event_id) WHERE (state = 'RECEIVED'::text)
  // inbox_payload_hash_check: CHECK (payload_hash ~ '^[a-f0-9]{64}$'::text)
  // inbox_state_check: CHECK (state = ANY (ARRAY['RECEIVED'::text, 'PROCESSED'::text, 'REJECTED'::text]))
}

Table platform.outbox {
  id text [pk, not null]
  aggregate_type text [not null]
  aggregate_id text [not null]
  event_type text [not null]
  payload jsonb [not null]
  available_at "timestamp with time zone" [not null, default: `now()`]
  attempt_count integer [not null, default: `0`]
  lease_owner text [null]
  lease_until "timestamp with time zone" [null]
  fence bigint [not null, default: `0`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  processed_at "timestamp with time zone" [null]
  last_error_code text [null]
  Note: '完整蓝图，建议后续；事务领域事件的可靠投递：aggregate/event/payload、available、attempts、lease/fence、processed。'
  // Conditional/expression index: CREATE INDEX outbox_dispatch_idx ON platform.outbox USING btree (available_at, id) WHERE (processed_at IS NULL)
  // outbox_attempt_count_check: CHECK (attempt_count >= 0)
  // outbox_check: CHECK ((lease_owner IS NULL) = (lease_until IS NULL))
  // outbox_fence_check: CHECK (fence >= 0)
  // outbox_payload_check: CHECK (jsonb_typeof(payload) = 'object'::text)
}

